{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Frontend",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Docker Compose Up",
            "type": "shell",
            "command": "docker compose -f docker-compose.local.yml up --build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Docker Compose Down",
            "type": "shell",
            "command": "docker compose -f docker-compose.local.yml down",
            "problemMatcher": []
        }
    ]
}